STORE_MODE=demo
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_VERSION=2026-10
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Optional exact public hostnames Shopify may use for hosted checkout, comma-separated.
# Add a custom storefront domain here if Shopify returns it as the checkout URL host.
SHOPIFY_CHECKOUT_HOSTS=
# Optional. Use the actual Dwears profile URLs; omit until they are ready.
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
# Auth is disabled unless a local account database and JWT signing secrets are configured.
AUTH_ENABLED=false
# Example: postgres://dwears_app:replace-me@127.0.0.1:5432/dwears
DATABASE_URL=
# Use a separate, more privileged migration account in production.
DATABASE_MIGRATION_URL=
# Generate each independently with a cryptographically secure random generator (32+ bytes).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Enable verified database TLS for remote databases. Production always requires verified TLS.
DATABASE_SSL=false
# Optional PEM CA certificate when the database uses a private certificate authority.
DATABASE_SSL_CA=
